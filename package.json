{
  "name": "ts-flags",
  "version": "0.1.0",
  "description": "Tiny, zero-dependency, type-safe feature flags with rules, stable percentage rollouts and a React binding.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm coverage && pnpm build && pnpm size",
    "prepublishOnly": "pnpm check",
    "lint": "biome lint ."
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "typescript",
    "react",
    "nextjs",
    "rollout",
    "ab-testing"
  ],
  "author": "Shubham Bhodiwal (https://github.com/shubham-bodiwal)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubham-bodiwal/ts-flags.git"
  },
  "homepage": "https://github.com/shubham-bodiwal/ts-flags#readme",
  "bugs": "https://github.com/shubham-bodiwal/ts-flags/issues",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
